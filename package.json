{
  "name": "linearlens",
  "version": "1.0.0",
  "description": "An interactive notebook for learning linear algebra",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:static": "STATIC_EXPORT=1 next build --webpack",
    "preview:workers": "npm run build:static && wrangler dev",
    "deploy:workers": "npm run build:static && wrangler deploy"
  },
  "keywords": [],
  "type": "module",
  "private": true,
  "dependencies": {
    "katex": "^0.18.9",
    "next": "^16.3.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.7",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3",
    "wrangler": "^4.145.0"
  },
  "engines": {
    "node": ">=20.9.0"
  }
}
